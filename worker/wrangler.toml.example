name = "zoko-task-agent"
main = "src/index.js"
compatibility_date = "2026-08-26"

[triggers]
crons = ["15 2 * * *"]

[vars]
ZOKI_PROVIDER = "claude-first"
CLAUDE_MODEL = "claude-haiku-5-5"
ALLOWED_ORIGINS = "https://eduflow-pro-12a90.web.app,https://yossileviway.github.io,http://localhost:5173"
GEMINI_MODEL = "gemini-flash-latest"

# Configure these with `wrangler secret put`:
# GEMINI_API_KEY
# ANTHROPIC_API_KEY   (Claude; console.anthropic.com API key — a Max subscription does not include API access)
# optional var: CLAUDE_MODEL (defaults to claude-sonnet-5-5)
# FIREBASE_WEB_API_KEY
# FIREBASE_PROJECT_ID
# FIREBASE_PROJECT_NUMBER
# FIREBASE_APP_IDS  (comma-separated Firebase app IDs)
# FIREBASE_CLIENT_EMAIL
# FIREBASE_PRIVATE_KEY
# GITHUB_APP_ID
# GITHUB_APP_PRIVATE_KEY
# GITHUB_INSTALLATION_ID
# SCHOOL_REPOSITORIES  (JSON: {"schoolId":"owner/private-repo"})
# Local model (Ollama, e.g. DictaLM) — Worker-only, never exposed to the browser:
# var ZOKI_PROVIDER = "claude-first" (default: Claude, then the school model on failure/over allowance) | "claude" (only Claude) | "local" (only the school model)
# optional vars: ZOKI_CLAUDE_LIMITS / ZOKI_DAILY_LIMITS (JSON per role) for per-user allowances
# (the school-ai service picks its own model; no LOCAL_MODEL_NAME needed)
# secret LOCAL_MODEL_URL (https tunnel address), LOCAL_MODEL_TOKEN (sent as x-api-key)
# optional secrets LOCAL_MODEL_ACCESS_ID / LOCAL_MODEL_ACCESS_SECRET (Cloudflare Access service token)
# optional var LOCAL_MODEL_TIERING = "off" (default: fast model first, strong model when slow/failing/no information), LOCAL_FAST_FIRST_TOKEN_MS (default 20000)
