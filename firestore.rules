rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasCurrentUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasCurrentUser()
        && (!('accountStatus' in currentUser()) || currentUser().accountStatus == 'active');
    }

    function isGlobalAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['global_admin'])
        && request.auth.token.global_admin == true;
    }

    function isPlatformAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['platform_admin'])
        && request.auth.token.platform_admin == true;
    }

    function isAnySchoolPrincipal() {
      return activeUser()
        && !isPlatformAdmin()
        && (
          (
            currentUser().role in ['principal', 'institution_manager']
            && (
              (currentUser().schoolId is string && currentUser().schoolId.size() > 0)
              || (currentUser().schoolIds is list && currentUser().schoolIds.size() > 0)
            )
          )
          || (
            'activeSchoolId' in currentUser()
            &&
            currentUser().activeSchoolId is string
            && currentUser().activeSchoolId.size() > 0
            && isSchoolPrincipal(currentUser().activeSchoolId)
          )
          || (
            'schoolId' in currentUser()
            &&
            currentUser().schoolId is string
            && currentUser().schoolId.size() > 0
            && isSchoolPrincipal(currentUser().schoolId)
          )
        );
    }

    function hasActiveForumMembership() {
      return activeUser()
        && exists(/databases/$(database)/documents/platformForumMemberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformForumMemberships/$(request.auth.uid)).data.status == 'active'
        && (
          get(/databases/$(database)/documents/platformForumMemberships/$(request.auth.uid)).data.get('expiresAt', null) == null
          || get(/databases/$(database)/documents/platformForumMemberships/$(request.auth.uid)).data.expiresAt > request.time
        );
    }

    function hasForumPermission(permission) {
      return isPlatformAdmin()
        || (
          isAnySchoolPrincipal()
          && permission in [
            'forum.access', 'forum.read', 'forum.createThread', 'forum.reply',
            'forum.editOwnPost', 'forum.deleteOwnPost', 'forum.uploadAttachment',
            'forum.createFolder', 'forum.editFolder'
          ]
        )
        || (
          hasActiveForumMembership()
          && permission in get(/databases/$(database)/documents/platformForumMemberships/$(request.auth.uid)).data.permissions
        );
    }

    function canUseForum() {
      return hasForumPermission('forum.access') && hasForumPermission('forum.read');
    }

    function validSparkForumAccessRequestCreate() {
      let data = request.resource.data;
      let targetPath = /databases/$(database)/documents/users/$(data.userId);
      return activeUser()
        && data.keys().hasOnly([
          'schoolId', 'institutionId', 'userId', 'requestedPermissions', 'reason',
          'expiresAt', 'status', 'requestedBy', 'writeMode', 'schemaVersion',
          'createdAt', 'updatedAt'
        ])
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.institutionId == data.schoolId
        && isSchoolPrincipal(data.schoolId)
        && data.userId is string
        && data.userId.size() > 0
        && exists(targetPath)
        && get(targetPath).data.get('accountStatus', 'active') == 'active'
        && (
          get(targetPath).data.get('schoolId', '') == data.schoolId
          || data.schoolId in get(targetPath).data.get('schoolIds', [])
        )
        && data.requestedPermissions is list
        && data.requestedPermissions.size() > 0
        && data.requestedPermissions.size() <= 9
        && data.requestedPermissions.hasOnly([
          'forum.createThread', 'forum.reply', 'forum.editOwnPost', 'forum.deleteOwnPost',
          'forum.createFolder', 'forum.editFolder', 'forum.pinThread',
          'forum.lockThread', 'forum.moderate'
        ])
        && data.reason is string
        && data.reason.size() >= 5
        && data.reason.size() <= 1000
        && (data.expiresAt == null || (data.expiresAt is timestamp && data.expiresAt > request.time))
        && data.status == 'pending_admin_approval'
        && data.requestedBy == request.auth.uid
        && data.writeMode == 'spark-client'
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validSparkForumAccessReview() {
      let next = request.resource.data;
      return isPlatformAdmin()
        && resource.data.status == 'pending_admin_approval'
        && next.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approvedPermissions', 'reviewedBy', 'reviewReason',
          'reviewedAt', 'updatedAt'
        ])
        && next.status in ['approved', 'rejected']
        && next.approvedPermissions is list
        && next.approvedPermissions.hasOnly(resource.data.requestedPermissions)
        && (
          (next.status == 'approved' && next.approvedPermissions.size() > 0)
          || (next.status == 'rejected' && next.approvedPermissions.size() == 0)
        )
        && next.reviewedBy == request.auth.uid
        && next.reviewReason is string
        && next.reviewReason.size() >= 3
        && next.reviewReason.size() <= 1000
        && next.reviewedAt == request.time
        && next.updatedAt == request.time;
    }

    function validSparkForumMembershipWrite(membershipId) {
      let data = request.resource.data;
      let approvalPath = /databases/$(database)/documents/platformForumAccessRequests/$(data.approvedRequestId);
      let targetPath = /databases/$(database)/documents/users/$(data.userId);
      let schoolMembershipPath = /databases/$(database)/documents/schools/$(data.schoolId)/memberships/$(data.userId);
      return isPlatformAdmin()
        && data.keys().hasOnly([
          'userId', 'schoolId', 'institutionId', 'status', 'permissions',
          'approvedRequestId', 'expiresAt', 'approvedBy', 'approvedAt',
          'updatedAt', 'writeMode', 'schemaVersion'
        ])
        && membershipId == data.userId
        && data.schoolId is string
        && data.schoolId.size() > 0
        && data.institutionId == data.schoolId
        && data.status == 'active'
        && data.permissions is list
        && data.permissions.hasOnly([
          'forum.access', 'forum.read', 'forum.createThread', 'forum.reply',
          'forum.editOwnPost', 'forum.deleteOwnPost', 'forum.createFolder',
          'forum.editFolder', 'forum.pinThread', 'forum.lockThread', 'forum.moderate'
        ])
        && data.permissions.hasAll(['forum.access', 'forum.read'])
        && data.approvedRequestId is string
        && data.approvedRequestId.size() > 0
        && existsAfter(approvalPath)
        && getAfter(approvalPath).data.status == 'approved'
        && getAfter(approvalPath).data.userId == data.userId
        && getAfter(approvalPath).data.schoolId == data.schoolId
        && getAfter(approvalPath).data.reviewedBy == request.auth.uid
        && data.permissions.hasAll(getAfter(approvalPath).data.approvedPermissions)
        && data.permissions.size() == getAfter(approvalPath).data.approvedPermissions.size() + 2
        && data.expiresAt == getAfter(approvalPath).data.expiresAt
        && exists(targetPath)
        && get(targetPath).data.get('accountStatus', 'active') == 'active'
        && (
          get(targetPath).data.get('schoolId', '') == data.schoolId
          || data.schoolId in get(targetPath).data.get('schoolIds', [])
          || (
            exists(schoolMembershipPath)
            && get(schoolMembershipPath).data.status == 'active'
          )
        )
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time
        && data.updatedAt == request.time
        && data.writeMode == 'spark-client'
        && data.schemaVersion == 1;
    }

    function validForumPublicIdentity(author) {
      return author is map
        && author.keys().hasOnly(['userId', 'fullName', 'publicRole', 'schoolId', 'schoolName', 'avatarUrl'])
        && author.userId == request.auth.uid
        && author.fullName is string
        && author.fullName.size() > 0
        && author.fullName.size() <= 120
        && author.fullName == currentUser().get('fullName', 'משתמש')
        && author.avatarUrl == ''
        && (
          (
            isPlatformAdmin()
            && author.publicRole == 'מנהל המערכת'
            && author.schoolId == ''
            && author.schoolName == ''
          )
          || (
            !isPlatformAdmin()
            && author.schoolId is string
            && author.schoolId.size() > 0
            && (
              author.schoolId == currentUser().get('schoolId', '')
              || author.schoolId in currentUser().get('schoolIds', [])
            )
            && author.schoolName is string
            && author.schoolName.size() <= 120
            && author.publicRole in ['מנהל מוסד', 'איש צוות']
          )
        );
    }

    function validSparkForumFolderCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'description', 'status', 'writeMode', 'schemaVersion',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.description is string
        && data.description.size() <= 160
        && data.status == 'active'
        && data.writeMode == 'spark-client'
        && data.schemaVersion == 1
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validSparkForumThreadCreate(rootId) {
      let data = request.resource.data;
      return rootId == 'root'
        && data.keys().hasOnly([
          'folderId', 'title', 'body', 'attachmentIds', 'authorId', 'author',
          'status', 'pinned', 'locked', 'replyCount', 'followers', 'writeMode',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.folderId is string
        && exists(/databases/$(database)/documents/platformForum/$(rootId)/folders/$(data.folderId))
        && get(/databases/$(database)/documents/platformForum/$(rootId)/folders/$(data.folderId)).data.status == 'active'
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 500
        && data.attachmentIds is list
        && data.attachmentIds.size() == 0
        && data.authorId == request.auth.uid
        && validForumPublicIdentity(data.author)
        && data.status == 'active'
        && data.pinned == false
        && data.locked == false
        && data.replyCount == 0
        && data.followers is list
        && data.followers.size() == 0
        && data.writeMode == 'spark-client'
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validSparkForumPostCreate(rootId, threadId) {
      let data = request.resource.data;
      let threadPath = /databases/$(database)/documents/platformForum/$(rootId)/threads/$(threadId);
      return rootId == 'root'
        && data.keys().hasOnly([
          'threadId', 'body', 'attachmentIds', 'authorId', 'author', 'status',
          'writeMode', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && exists(threadPath)
        && get(threadPath).data.status == 'active'
        && get(threadPath).data.get('locked', false) == false
        && data.threadId == threadId
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 400
        && data.attachmentIds is list
        && data.attachmentIds.size() == 0
        && data.authorId == request.auth.uid
        && validForumPublicIdentity(data.author)
        && data.status == 'active'
        && data.writeMode == 'spark-client'
        && data.schemaVersion == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validForumFollowUpdate() {
      let oldFollowers = resource.data.get('followers', []);
      let newFollowers = request.resource.data.followers;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'updatedAt'])
        && newFollowers is list
        && newFollowers.size() <= 50
        && newFollowers.toSet().size() == newFollowers.size()
        && newFollowers.toSet().difference(oldFollowers.toSet()).hasOnly([request.auth.uid])
        && oldFollowers.toSet().difference(newFollowers.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.updatedAt == request.time;
    }

    function validForumContentDelete() {
      return (
          (resource.data.authorId == request.auth.uid && hasForumPermission('forum.deleteOwnPost'))
          || hasForumPermission('forum.moderate')
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'body', 'attachmentIds', 'deletedBy', 'deletedAt', 'updatedAt'
        ])
        && request.resource.data.status == 'deleted'
        && request.resource.data.body == ''
        && request.resource.data.attachmentIds is list
        && request.resource.data.attachmentIds.size() == 0
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validForumModerationUpdate() {
      return (
          (
            hasForumPermission('forum.pinThread')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'updatedAt'])
            && request.resource.data.pinned == !resource.data.get('pinned', false)
          )
          || (
            hasForumPermission('forum.lockThread')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locked', 'updatedAt'])
            && request.resource.data.locked == !resource.data.get('locked', false)
          )
        )
        && request.resource.data.updatedAt == request.time;
    }

    function isSchoolMember(schoolId) {
      // Platform support is intentionally not a school member, even if a
      // legacy user document still contains schoolId/schoolIds.
      return activeUser() && !isPlatformAdmin() && (
        isGlobalAdmin()
        || (
          exists(/databases/$(database)/documents/schools/$(schoolId)/memberships/$(request.auth.uid))
          && get(/databases/$(database)/documents/schools/$(schoolId)/memberships/$(request.auth.uid)).data.status == 'active'
        )
        || (currentUser().schoolId is string && currentUser().schoolId == schoolId)
        || (currentUser().schoolIds is list && schoolId in currentUser().schoolIds)
      );
    }

    function isSchoolPrincipal(schoolId) {
      return isSchoolMember(schoolId) && (
        currentUser().role in ['principal', 'institution_manager']
        || (
          'rolesBySchool' in currentUser()
          &&
          currentUser().rolesBySchool is map
          && schoolId in currentUser().rolesBySchool
          && currentUser().rolesBySchool[schoolId] in ['principal', 'institution_manager']
        )
      );
    }

    function canViewSchoolResource(schoolId) {
      return isSchoolMember(schoolId);
    }

    function canEditSchoolResource(schoolId) {
      return isGlobalAdmin()
        || isSchoolPrincipal(schoolId)
        || (isSchoolMember(schoolId) && currentUser().role == 'editor');
    }

    function canManageSchoolUsers(schoolId) {
      return isGlobalAdmin() || isSchoolPrincipal(schoolId);
    }

    function hasPermission(schoolId, permission) {
      return canManageSchoolUsers(schoolId)
        || (
          isSchoolMember(schoolId)
          && currentUser().permissions is map
          && permission in currentUser().permissions
          && currentUser().permissions[permission] == true
        );
    }

    function resourceAclPolicy(schoolId, resourceType, resourceId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/resourceAclPolicies/$(resourceType + '_' + resourceId)).data;
    }

    function hasResourceAclPolicy(schoolId, resourceType, resourceId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId)/resourceAclPolicies/$(resourceType + '_' + resourceId))
        && resourceAclPolicy(schoolId, resourceType, resourceId).configured == true;
    }

    function legacyIdsAllowedForSchool(schoolId) {
      return currentUser().schoolId == schoolId
        && currentUser().get('schoolIds', []).size() <= 1;
    }

    function currentUserRoleIds(schoolId) {
      let legacyIds = legacyIdsAllowedForSchool(schoolId) ? currentUser().get('customRoleIds', []) : [];
      return currentUser().get('customRoleAssignments', {}).get(schoolId, legacyIds);
    }

    function aclPrincipalMatches(schoolId, levelData, prefix) {
      let legacyTeams = legacyIdsAllowedForSchool(schoolId) ? currentUser().get('teamIds', []) : [];
      let legacyClasses = legacyIdsAllowedForSchool(schoolId) ? currentUser().get('classIds', []) : [];
      let teamIds = currentUser().get('teamIdsBySchool', {}).get(schoolId, legacyTeams);
      let classIds = currentUser().get('classIdsBySchool', {}).get(schoolId, legacyClasses);
      return request.auth.uid in levelData[prefix + 'Users']
        || levelData[prefix + 'Teams'].hasAny(teamIds)
        || levelData[prefix + 'Roles'].hasAny(currentUserRoleIds(schoolId))
        || levelData[prefix + 'Classes'].hasAny(classIds);
    }

    function directResourceAclAllows(schoolId, resourceType, resourceId, accessLevel) {
      let levelData = resourceAclPolicy(schoolId, resourceType, resourceId)[accessLevel];
      return isSchoolPrincipal(schoolId)
        || (!aclPrincipalMatches(schoolId, levelData, 'denied') && aclPrincipalMatches(schoolId, levelData, 'allowed'));
    }

    function resourceAclAllows(schoolId, resourceType, resourceId, accessLevel, parentId) {
      return isSchoolPrincipal(schoolId) || (
        hasResourceAclPolicy(schoolId, resourceType, resourceId)
          ? directResourceAclAllows(schoolId, resourceType, resourceId, accessLevel)
          : (
            parentId is string
            && hasResourceAclPolicy(schoolId, 'folder', parentId)
            && directResourceAclAllows(schoolId, 'folder', parentId, accessLevel)
          )
      );
    }

    function resourceAclConfigured(schoolId, resourceType, resourceId, parentId) {
      return hasResourceAclPolicy(schoolId, resourceType, resourceId)
        || (parentId is string && hasResourceAclPolicy(schoolId, 'folder', parentId));
    }

    function hasStudentDataAccess(schoolId) {
      return activeUser() && (
        (
          request.auth.token.keys().hasAny(['global_admin'])
          && request.auth.token.global_admin == true
          && request.auth.token.keys().hasAny(['student_data_access'])
          && request.auth.token.student_data_access == true
        ) || (
          !(request.auth.token.keys().hasAny(['global_admin']) && request.auth.token.global_admin == true)
          && (
            (currentUser().schoolId is string && currentUser().schoolId == schoolId)
            || (currentUser().schoolIds is list && schoolId in currentUser().schoolIds)
          )
        )
      );
    }

    function studentPermission(permission) {
      return currentUser().permissions is map
        && currentUser().permissions.get(permission, false) == true;
    }

    function hasSchoolWideStudentReadPermission() {
      return studentPermission('students_view')
        || studentPermission('students_edit')
        || studentPermission('students_update')
        || studentPermission('students_archive')
        || studentPermission('students_transfer_class')
        || studentPermission('students_manage_programs')
        || studentPermission('students.promote')
        || studentPermission('classes.promote')
        || studentPermission('students.markGraduate')
        || studentPermission('students.markWithdrawn')
        || studentPermission('students.markDropout')
        || studentPermission('students.restore')
        || studentPermission('attendance_view')
        || studentPermission('attendance_edit')
        || studentPermission('attendance_create')
        || studentPermission('grades.view')
        || studentPermission('grades.edit')
        || studentPermission('gradebooks.manage');
    }

    function hasSchoolWideClassReadPermission() {
      return hasSchoolWideStudentReadPermission()
        || studentPermission('classes_view')
        || studentPermission('classes_create')
        || studentPermission('classes_update')
        || studentPermission('classes_archive')
        || studentPermission('classes_assign_teacher')
        || studentPermission('students_create')
        || studentPermission('attendance_manage_legend')
        || studentPermission('attendance_manage_dates');
    }

    function rolePermission(schoolId, permission) {
      return 'rolePermissionsBySchool' in currentUser()
        && currentUser().rolePermissionsBySchool is map
        && schoolId in currentUser().rolePermissionsBySchool
        && currentUser().rolePermissionsBySchool[schoolId] is map
        && permission in currentUser().rolePermissionsBySchool[schoolId]
        && currentUser().rolePermissionsBySchool[schoolId][permission] == true;
    }

    // Communication content is intentionally excluded from implicit manager or
    // platform-wide access. A manager may create their own draft, but reading
    // somebody else's private content requires an explicit permission grant.
    function communicationPermission(schoolId, permission) {
      return isSchoolMember(schoolId)
        && !isPlatformAdmin()
        && (
          (
            currentUser().permissions is map
            && currentUser().permissions.get(permission, false) == true
          )
          || rolePermission(schoolId, permission)
        );
    }

    function canCreateCommunication(schoolId) {
      return !isPlatformAdmin()
        && (isSchoolPrincipal(schoolId) || communicationPermission(schoolId, 'communications.create'));
    }

    function canReadCommunicationTemplates(schoolId) {
      return canCreateCommunication(schoolId)
        || communicationPermission(schoolId, 'communications.useAgent')
        || communicationPermission(schoolId, 'communications.manageTemplates');
    }

    function canManageCommunicationTemplates(schoolId) {
      return !isPlatformAdmin()
        && (isSchoolPrincipal(schoolId) || communicationPermission(schoolId, 'communications.manageTemplates'));
    }

    function validCommunicationTemplate(data, schoolId, ownerId, scope) {
      return data.keys().hasOnly([
          'scope', 'name', 'category', 'subjectTemplate', 'bodyTemplate', 'tone',
          'schoolId', 'ownerId', 'archived', 'archivedBy', 'archivedAt',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && data.scope == scope
        && data.schoolId == schoolId
        && data.ownerId == ownerId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.category is string
        && data.category.size() <= 80
        && data.subjectTemplate is string
        && data.subjectTemplate.size() <= 300
        && data.bodyTemplate is string
        && data.bodyTemplate.size() > 0
        && data.bodyTemplate.size() <= 10000
        && data.tone in ['respectful', 'direct', 'friendly', 'formal']
        && data.archived is bool
        && data.archivedBy is string
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.schemaVersion == 1;
    }

    function validCommunicationTemplateCreate(data, schoolId, ownerId, scope) {
      return validCommunicationTemplate(data, schoolId, ownerId, scope)
        && data.archived == false
        && data.archivedBy == ''
        && data.archivedAt == null
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function safeCommunicationTemplateUpdate(schoolId, ownerId, scope) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.archived == false
        && validCommunicationTemplate(request.resource.data, schoolId, ownerId, scope)
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (
            changed.hasOnly([
              'name', 'category', 'subjectTemplate', 'bodyTemplate', 'tone',
              'updatedBy', 'updatedAt'
            ])
            && request.resource.data.archived == false
            && request.resource.data.archivedBy == ''
            && request.resource.data.archivedAt == null
          )
          || (
            changed.hasOnly(['archived', 'archivedBy', 'archivedAt', 'updatedBy', 'updatedAt'])
            && request.resource.data.archived == true
            && request.resource.data.archivedBy == request.auth.uid
            && request.resource.data.archivedAt == request.time
          )
        );
    }

    function contactGrant(schoolId, permission) {
      return isGlobalAdmin()
        || currentUser().role in ['principal', 'institution_manager']
        || currentUser().get('rolesBySchool', {}).get(schoolId, '') in ['principal', 'institution_manager']
        || currentUser().get('permissions', {}).get(permission, false) == true
        || rolePermission(schoolId, permission);
    }

    function canReadInstitutionalContact(schoolId, data) {
      return isSchoolMember(schoolId)
        && !isPlatformAdmin()
        && (
          data.get('createdBy', '') == request.auth.uid
          || request.auth.uid in data.get('ownerStaffIds', [])
          || (
            data.get('visibility', 'responsible_staff') == 'institution'
            && contactGrant(schoolId, 'contacts.view')
          )
          || contactGrant(schoolId, 'contacts.edit')
        );
    }

    function validInstitutionalContactValues(schoolId, data) {
      return data.scope == 'institutional'
        && data.schoolId == schoolId
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 160
        && data.organization is string
        && data.organization.size() <= 160
        && data.jobTitle is string
        && data.jobTitle.size() <= 120
        && data.primaryEmail is string
        && data.primaryEmail.size() > 3
        && data.primaryEmail.size() <= 320
        && data.additionalEmails is list
        && data.additionalEmails.size() <= 9
        && data.normalizedEmails is list
        && data.normalizedEmails.size() > 0
        && data.normalizedEmails.size() <= 10
        && data.normalizedEmails[0] == data.primaryEmail
        && data.phone is string
        && data.phone.size() <= 40
        && data.category is string
        && data.category.size() <= 80
        && (data.organization.size() > 0 || data.category.size() > 0)
        && data.tags is list
        && data.tags.size() <= 20
        && data.notes is string
        && data.notes.size() <= 2000
        && data.ownerStaffIds is list
        && data.ownerStaffIds.size() <= 50
        && data.visibility in ['institution', 'responsible_staff']
        && data.linkedStaffId is string
        && data.archived is bool
        && data.schemaVersion == 1
        && data.createdBy is string
        && data.updatedBy is string
        && data.archivedBy is string
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.mergedIntoId is string
        && data.mergedFromIds is list
        && data.mergedFromIds.size() <= 50;
    }

    function validInstitutionalContactCreate(schoolId, data) {
      return isSchoolMember(schoolId)
        && contactGrant(schoolId, 'contacts.create')
        && data.keys().hasOnly([
          'scope', 'schoolId', 'fullName', 'organization', 'jobTitle', 'primaryEmail',
          'additionalEmails', 'normalizedEmails', 'phone', 'category', 'tags', 'notes',
          'ownerStaffIds', 'visibility', 'linkedStaffId', 'archived', 'schemaVersion',
          'createdBy', 'updatedBy', 'archivedBy', 'archivedAt', 'mergedIntoId',
          'mergedFromIds', 'createdAt', 'updatedAt'
        ])
        && validInstitutionalContactValues(schoolId, data)
        && data.archived == false
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid
        && data.archivedBy == ''
        && data.archivedAt == null
        && data.mergedIntoId == ''
        && data.mergedFromIds.size() == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validContactMergeValues(data) {
      return data.primaryEmail is string
        && data.primaryEmail.size() > 3
        && data.primaryEmail.size() <= 320
        && data.additionalEmails is list
        && data.additionalEmails.size() <= 9
        && data.normalizedEmails is list
        && data.normalizedEmails.size() > 0
        && data.normalizedEmails.size() <= 10
        && data.normalizedEmails[0] == data.primaryEmail
        && data.tags is list
        && data.tags.size() <= 20
        && data.mergedIntoId is string
        && data.mergedFromIds is list
        && data.mergedFromIds.size() <= 50;
    }

    function safeInstitutionalContactUpdate(schoolId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let mergeChange = changed.hasAny(['mergedIntoId', 'mergedFromIds']);
      let archiveChange = changed.hasAny(['archived', 'archivedBy', 'archivedAt']);
      return isSchoolMember(schoolId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.scope == resource.data.scope
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          mergeChange
          ? (
            contactGrant(schoolId, 'contacts.merge')
            && changed.hasOnly([
              'primaryEmail', 'additionalEmails', 'normalizedEmails', 'tags',
              'mergedIntoId', 'mergedFromIds', 'archived', 'archivedBy',
              'archivedAt', 'updatedBy', 'updatedAt'
            ])
            && validContactMergeValues(request.resource.data)
            && (
              request.resource.data.mergedIntoId == ''
              || (
                request.resource.data.archived == true
                && request.resource.data.archivedBy == request.auth.uid
                && request.resource.data.archivedAt == request.time
              )
            )
          )
          : archiveChange
          ? (
            contactGrant(schoolId, 'contacts.archive')
            && changed.hasOnly(['archived', 'archivedBy', 'archivedAt', 'updatedBy', 'updatedAt'])
            && (
              (
                request.resource.data.archived == true
                && request.resource.data.archivedBy == request.auth.uid
                && request.resource.data.archivedAt == request.time
              )
              || (
                request.resource.data.archived == false
                && request.resource.data.archivedBy == ''
                && request.resource.data.archivedAt == null
              )
            )
          )
          : (
            contactGrant(schoolId, 'contacts.edit')
            && changed.hasOnly([
              'fullName', 'organization', 'jobTitle', 'primaryEmail', 'additionalEmails',
              'normalizedEmails', 'phone', 'category', 'tags', 'notes', 'ownerStaffIds',
              'visibility', 'linkedStaffId', 'updatedBy', 'updatedAt'
            ])
            && validInstitutionalContactValues(schoolId, request.resource.data)
          )
        );
    }

    function validPrivateContactValues(userId, data) {
      return data.scope == 'private'
        && data.ownerId == userId
        && data.schoolId is string
        && isSchoolMember(data.schoolId)
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 160
        && data.organization is string
        && data.organization.size() <= 160
        && data.jobTitle is string
        && data.jobTitle.size() <= 120
        && data.primaryEmail is string
        && data.primaryEmail.size() > 3
        && data.primaryEmail.size() <= 320
        && data.additionalEmails is list
        && data.additionalEmails.size() <= 9
        && data.normalizedEmails is list
        && data.normalizedEmails.size() > 0
        && data.normalizedEmails.size() <= 10
        && data.normalizedEmails[0] == data.primaryEmail
        && data.phone is string
        && data.phone.size() <= 40
        && data.category is string
        && data.category.size() <= 80
        && data.tags is list
        && data.tags.size() <= 20
        && data.notes is string
        && data.notes.size() <= 2000
        && data.archived is bool
        && data.schemaVersion == 1
        && data.createdBy == userId
        && data.updatedBy == userId
        && data.archivedBy is string
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && data.mergedIntoId is string
        && data.mergedFromIds is list
        && data.mergedFromIds.size() <= 50;
    }

    function validPrivateContactCreate(userId, data) {
      return signedIn()
        && request.auth.uid == userId
        && !isPlatformAdmin()
        && data.keys().hasOnly([
          'scope', 'ownerId', 'schoolId', 'fullName', 'organization', 'jobTitle',
          'primaryEmail', 'additionalEmails', 'normalizedEmails', 'phone', 'category',
          'tags', 'notes', 'archived', 'schemaVersion', 'createdBy', 'updatedBy',
          'archivedBy', 'archivedAt', 'mergedIntoId', 'mergedFromIds',
          'createdAt', 'updatedAt'
        ])
        && validPrivateContactValues(userId, data)
        && data.archived == false
        && data.archivedBy == ''
        && data.archivedAt == null
        && data.mergedIntoId == ''
        && data.mergedFromIds.size() == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function safePrivateContactUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let mergeChange = changed.hasAny(['mergedIntoId', 'mergedFromIds']);
      let archiveChange = changed.hasAny(['archived', 'archivedBy', 'archivedAt']);
      return signedIn()
        && request.auth.uid == userId
        && !isPlatformAdmin()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == userId
        && request.resource.data.updatedAt == request.time
        && (
          mergeChange
          ? (
            changed.hasOnly([
              'primaryEmail', 'additionalEmails', 'normalizedEmails', 'tags',
              'mergedIntoId', 'mergedFromIds', 'archived', 'archivedBy',
              'archivedAt', 'updatedBy', 'updatedAt'
            ])
            && validContactMergeValues(request.resource.data)
            && (
              request.resource.data.mergedIntoId == ''
              || (
                request.resource.data.archived == true
                && request.resource.data.archivedBy == userId
                && request.resource.data.archivedAt == request.time
              )
            )
          )
          : archiveChange
          ? (
            changed.hasOnly(['archived', 'archivedBy', 'archivedAt', 'updatedBy', 'updatedAt'])
            && (
              (
                request.resource.data.archived == true
                && request.resource.data.archivedBy == userId
                && request.resource.data.archivedAt == request.time
              )
              || (
                request.resource.data.archived == false
                && request.resource.data.archivedBy == ''
                && request.resource.data.archivedAt == null
              )
            )
          )
          : (
            changed.hasOnly([
              'fullName', 'organization', 'jobTitle', 'primaryEmail', 'additionalEmails',
              'normalizedEmails', 'phone', 'category', 'tags', 'notes', 'updatedBy', 'updatedAt'
            ])
            && validPrivateContactValues(userId, request.resource.data)
          )
        );
    }

    function canReadCommunication(schoolId, data) {
      return isSchoolMember(schoolId)
        && !isPlatformAdmin()
        && data.schoolId == schoolId
        && (
          data.createdBy == request.auth.uid
          || data.get('followUpAssigneeId', '') == request.auth.uid
          || request.auth.uid in data.get('participantIds', [])
          || communicationPermission(schoolId, 'communications.viewAll')
          || (
            data.get('visibility', 'private') == 'team'
            && communicationPermission(schoolId, 'communications.viewTeam')
            && data.get('linkedTeamId', '') is string
            && data.get('linkedTeamId', '').size() > 0
            && data.get('linkedTeamId', '') in currentUserInitiativeTeamIds(schoolId)
          )
        );
    }

    function validCommunicationTaskCreate(userId, taskId, data) {
      let draftPath = /databases/$(database)/documents/schools/$(data.schoolId)/communicationDrafts/$(data.communicationDraftId);
      return data.workflowType == 'external_email_followup'
        && data.communicationStatus == 'awaiting_send'
        && data.taskStatus == 'todo'
        && data.communicationDraftId is string
        && data.communicationDraftId.size() > 0
        && data.communicationTrackingId is string
        && data.nextFollowUpAt is string
        && data.completionCriteria is string
        && data.sourceTaskId is string
        && data.sourceTaskId.size() > 0
        && data.sourceTaskStorageMode in ['personal', 'nested', 'legacy', 'context']
        && data.linkedContextType in ['general', 'task', 'student', 'team', 'initiative', 'milestone', 'event', 'contact']
        && data.linkedContextId is string
        && data.linkedContextId.size() > 0
        && data.linkedContextLabel is string
        && data.linkedContextLabel.size() > 0
        && data.linkedContextLabel.size() <= 300
        && data.communicationSubject is string
        && data.communicationSubject.size() > 0
        && data.communicationSubject.size() <= 300
        && data.externalRecipientLabel is string
        && data.externalRecipientLabel.size() > 0
        && data.externalRecipientLabel.size() <= 320
        && existsAfter(draftPath)
        && getAfter(draftPath).data.taskId == taskId
        && getAfter(draftPath).data.createdBy == userId
        && getAfter(draftPath).data.trackingId == data.communicationTrackingId;
    }

    function safeCommunicationTaskStatusUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let draftPath = /databases/$(database)/documents/schools/$(resource.data.schoolId)/communicationDrafts/$(resource.data.communicationDraftId);
      let nextStatus = request.resource.data.communicationStatus;
      return personalTaskOwner(userId, resource.data)
        && personalTaskOwner(userId, request.resource.data)
        && resource.data.workflowType == 'external_email_followup'
        && request.resource.data.workflowType == resource.data.workflowType
        && request.resource.data.communicationDraftId == resource.data.communicationDraftId
        && request.resource.data.communicationTrackingId == resource.data.communicationTrackingId
        && changed.hasOnly([
          'communicationStatus', 'taskStatus', 'status', 'completedAt', 'nextFollowUpAt',
          'dueDate', 'updatedAt'
        ])
        && nextStatus in [
          'awaiting_send', 'awaiting_reply', 'reply_received_in_progress',
          'action_required', 'postponed', 'resolved', 'closed_without_reply', 'cancelled'
        ]
        && existsAfter(draftPath)
        && getAfter(draftPath).data.communicationStatus == nextStatus
        && getAfter(draftPath).data.nextFollowUpAt == request.resource.data.nextFollowUpAt
        && request.resource.data.updatedAt == request.time
        && (nextStatus in ['resolved', 'closed_without_reply', 'cancelled']
          ? (
            request.resource.data.taskStatus == 'done'
            && request.resource.data.status == 'done'
            && request.resource.data.completedAt == request.time
          )
          : (
            request.resource.data.taskStatus == 'todo'
            && request.resource.data.status == 'todo'
            && request.resource.data.completedAt == null
          ));
    }

    function validCommunicationDraftCreate(schoolId, draftId, data) {
      let taskPath = /databases/$(database)/documents/users/$(request.auth.uid)/personalTasks/$(data.taskId);
      return canCreateCommunication(schoolId)
        && data.keys().hasOnly([
          'schoolId', 'trackingId', 'taskId', 'workflowType', 'communicationStatus',
          'subject', 'draftBody', 'summary', 'to', 'cc', 'bcc', 'linkedContactId',
          'createdBy', 'confirmedSentBy', 'confirmedSentAt', 'followUpAssigneeId',
          'nextFollowUpAt', 'priority', 'completionCriteria', 'sourceTaskId',
          'sourceTaskStorageMode', 'sourceTaskOwnerId', 'linkedStudentId',
          'linkedClassId', 'linkedTeamId', 'linkedInitiativeId', 'linkedMilestoneId',
          'linkedEventId', 'linkedContextType', 'linkedContextId', 'linkedContextLabel',
          'linkedFileIds', 'links', 'actionHistory', 'reminderHistory',
          'visibility', 'participantIds', 'lastEventId', 'reminderNotifiedFor',
          'schemaVersion', 'createdAt', 'updatedAt'
