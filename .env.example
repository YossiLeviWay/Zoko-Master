VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_AI_MODEL=gemini-3.5-flash-lite
VITE_TASK_ASSISTANT_ENABLED=true
VITE_TASK_ASSISTANT_MAX_INPUT=1800
VITE_TASK_ASSISTANT_WINDOW_LIMIT=6
VITE_TASK_ASSISTANT_DAILY_LIMIT=20
VITE_TASK_ASSISTANT_TIMEOUT_MS=12000
# Gemini API credentials are server-only. Configure with:
# firebase functions:secrets:set GEMINI_API_KEY
# Optional server parameter: GEMINI_TASK_MODEL=gemini-flash-latest
VITE_FIRESTORE_DATA_MODE=legacy
VITE_FIRESTORE_READ_MODE=legacy
